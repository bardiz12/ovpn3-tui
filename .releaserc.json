{
  "branches": [
    "main",
    "master"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/^version = \".*\"/version = \"${nextRelease.version}\"/' Cargo.toml && cargo check"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "Cargo.toml",
          "Cargo.lock"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "target/release/ovpn3-tui",
            "label": "ovpn3-tui Linux x86_64 Binary"
          },
          {
            "path": "ovpn3-tui-*.tar.gz",
            "label": "ovpn3-tui Release Archive"
          },
          {
            "path": "ovpn3-tui-*.sha256",
            "label": "SHA256 Checksums"
          }
        ]
      }
    ]
  ]
}
